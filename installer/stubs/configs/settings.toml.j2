# {{ project_name }} — application configuration
#
# Access settings in code:
#   from {{ pkg_name }}.config import settings
#   debug = settings["app"]["debug"]   # nested TOML key
#   name  = settings["APP_NAME"]       # flat .env key
#
{% if env_parsing == "dynaconf" %}
# Dynaconf: reference env vars with @format {env[VAR_NAME]}
# Set the matching variable in .env to override at runtime.

[app]
name = "@format {env[APP_NAME]}"
version = "@format {env[APP_VERSION]}"
debug = "@format {env[APP_DEBUG]}"
{% else %}
# Dotenv: these are structured defaults.
# Override any key by adding a flat entry to .env:
#   APP_NAME=my-override  →  settings["APP_NAME"]
# (Nested TOML keys are not replaced by .env — use get_env() in code for that.)

[app]
name = "{{ project_name }}"       # env: APP_NAME
version = "{{ version }}"         # env: APP_VERSION
debug = false                     # env: APP_DEBUG (true/false)
{% endif %}
