#!/usr/bin/env bash
# seed.sh — seed the database with initial data.
#
# Usage:
#   ./scripts/seed.sh                  # run ALL seeders in order
#   ./scripts/seed.sh 001_seed_users   # run a single seeder (with or without .sql)
#
# Source your .env before calling:
#   source .env && ./scripts/seed.sh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SEEDERS_DIR="$SCRIPT_DIR/../database/seeders"

{% if db_driver == "postgresql" %}
: "${DB_HOST:=127.0.0.1}"
: "${DB_PORT:=5432}"
: "${DB_USER:=postgres}"
: "${DB_NAME:={{ pkg_name }}}"
: "${DB_PASSWORD:=}"

_run_sql() {
    PGPASSWORD="$DB_PASSWORD" psql \
        --host="$DB_HOST" \
        --port="$DB_PORT" \
        --username="$DB_USER" \
        --dbname="$DB_NAME" \
        --file="$1"
}
{% elif db_driver == "mysql" or db_driver == "mariadb" %}
: "${DB_HOST:=127.0.0.1}"
: "${DB_PORT:=3306}"
: "${DB_USER:=root}"
: "${DB_NAME:={{ pkg_name }}}"
: "${DB_PASSWORD:=}"

_run_sql() {
    mysql \
        --host="$DB_HOST" \
        --port="$DB_PORT" \
        --user="$DB_USER" \
        --password="$DB_PASSWORD" \
        "$DB_NAME" < "$1"
}
{% elif db_driver == "sqlite" %}
: "${DB_PATH:={{ pkg_name }}.db}"

_run_sql() {
    sqlite3 "$DB_PATH" < "$1"
}
{% elif db_driver == "mssql" %}
: "${DB_HOST:=127.0.0.1}"
: "${DB_PORT:=1433}"
: "${DB_USER:=sa}"
: "${DB_NAME:={{ pkg_name }}}"
: "${DB_PASSWORD:=}"

_run_sql() {
    sqlcmd \
        -S "${DB_HOST},${DB_PORT}" \
        -U "$DB_USER" \
        -P "$DB_PASSWORD" \
        -d "$DB_NAME" \
        -i "$1"
}
{% elif db_driver == "oracle" %}
: "${DB_HOST:=127.0.0.1}"
: "${DB_PORT:=1521}"
: "${DB_USER:=system}"
: "${DB_NAME:={{ pkg_name }}}"
: "${DB_PASSWORD:=}"

_run_sql() {
    sqlplus -S "${DB_USER}/${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}" "@$1"
}
{% else %}
_run_sql() {
    echo "ERROR: no run_sql implementation for driver '{{ db_driver }}'." >&2
    exit 1
}
{% endif %}

# ── Single seeder ─────────────────────────────────────────────────────────────
if [[ $# -ge 1 ]]; then
    target="${1%.sql}.sql"   # normalise — add .sql if missing
    seed_file="$SEEDERS_DIR/$target"

    if [[ ! -f "$seed_file" ]]; then
        echo "ERROR: seeder not found: $seed_file" >&2
        exit 1
    fi

    echo "Seeding: $(basename "$seed_file")"
    _run_sql "$seed_file"
    echo "Done."
    exit 0
fi

# ── All seeders ───────────────────────────────────────────────────────────────
shopt -s nullglob
seed_files=( "$SEEDERS_DIR"/*.sql )

if [[ -z "${seed_files[*]}" ]]; then
    echo "No seeder files found in $SEEDERS_DIR"
    exit 0
fi

echo "Running all seeders from: $SEEDERS_DIR"
for seed_file in "${seed_files[@]}"; do
    echo "  → $(basename "$seed_file")"
    _run_sql "$seed_file"
done

echo "Seeding complete."
