from __future__ import annotations
{% if cli_support == "typer" %}
from typing import Annotated

import typer
from rich.console import Console
from rich.panel import Panel

console = Console()


def hello_command(
    # Typer passes the shared context automatically — use it to read global flags
    # (verbose, debug) that were set in the @app.callback() in __main__.py.
    ctx: typer.Context,
    # Required positional argument — the person to greet.
    name: Annotated[str, typer.Argument(help="Name of the person to greet.")],
    # Optional flag: how many times to repeat the greeting (must be ≥ 1).
    count: Annotated[
        int,
        typer.Option("--count", "-n", help="Number of times to repeat the greeting.", min=1),
    ] = 1,
    # Boolean switch: convert greeting to uppercase.
    upper: Annotated[
        bool,
        typer.Option("--upper/--no-upper", help="Print greeting in UPPERCASE."),
    ] = False,
) -> None:
    """Greet NAME, optionally multiple times."""

    # ── Read global flags from context ────────────────────────────────────────
    # These were set by _main_callback in __main__.py and are available in every
    # command. Access pattern: ctx.obj.get("<flag>", <default>)
    debug   = ctx.obj.get("debug",   False) if ctx.obj else False
    verbose = ctx.obj.get("verbose", False) if ctx.obj else False

    # ── Debug output ──────────────────────────────────────────────────────────
    # Trigger: {{ pkg_name }} --debug hello Alice
    if debug:
        opts = {
            "name":  name,
            "count": count,
            "upper": upper,
        }
        rows = "\n".join(f"[bold]{k}[/bold] = {v!r}" for k, v in opts.items())
        console.print(Panel(rows, title="[cyan]hello — debug args[/cyan]", expand=False))

    # ── Validation ────────────────────────────────────────────────────────────
    # Typer enforces `min=1` on count, but you can add richer business rules here.
    if not name.strip():
        raise typer.BadParameter("name cannot be blank.", param_hint="'NAME'")

    # ── Verbose output ────────────────────────────────────────────────────────
    # Trigger: {{ pkg_name }} --verbose hello Alice
    if verbose:
        console.print(f"[dim]hello: greeting '{name}' × {count}[/dim]")

    # ── Command logic ─────────────────────────────────────────────────────────
    greeting = f"Hello, {name}!"
    if upper:
        greeting = greeting.upper()

    for _ in range(count):
        console.print(f"[green]{greeting}[/green]")
{% elif cli_support == "argparse" %}
import argparse


def register(subparsers: argparse._SubParsersAction) -> None:  # noqa: SLF001
    """Register the ``hello`` subcommand with *subparsers*."""
    p = subparsers.add_parser("hello", description="Greet a person by name.")

    # Required argument.
    p.add_argument("name", help="Name of the person to greet.")

    # Optional flag with a default value.
    p.add_argument(
        "--count", "-n",
        type=int,
        default=1,
        metavar="N",
        help="Number of times to repeat the greeting. Must be ≥ 1. (default: %(default)s)",
    )

    # Boolean switch — store_true means passing the flag sets it to True.
    p.add_argument(
        "--upper",
        action="store_true",
        help="Print greeting in UPPERCASE.",
    )


def hello_command(args: argparse.Namespace) -> None:
    """Execute the ``hello`` subcommand from parsed *args*.

    Global flags (args.verbose, args.debug) are set by App.run() in __main__.py
    and are available here because argparse attaches them to the same Namespace.
    """

    # ── Validation ────────────────────────────────────────────────────────────
    if not args.name.strip():
        raise SystemExit("Error: name cannot be blank.")

    if args.count < 1:
        raise SystemExit("Error: --count must be ≥ 1.")

    # ── Verbose output ────────────────────────────────────────────────────────
    # Triggered by: {{ pkg_name }} --verbose hello Alice
    if args.verbose:
        print(f"[verbose] hello: greeting '{args.name}' × {args.count}")

    # ── Command logic ─────────────────────────────────────────────────────────
    greeting = f"Hello, {args.name}!"
    if args.upper:
        greeting = greeting.upper()

    for _ in range(args.count):
        print(greeting)
{% endif %}
