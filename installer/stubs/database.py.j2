def _connection_params() -> dict:
    {% if has_env_module %}
    return {
        "host":     get_env("DB_HOST", "127.0.0.1"),
        "port":     int(get_env("DB_PORT", "3306")),
        "user":     get_env("DB_USER", "root"),
        "password": get_env("DB_PASSWORD", ""),
        "database": get_env("DB_NAME", "{{ pkg_name }}"),
        "cursorclass": pymysql.cursors.DictCursor,
    }
    {% else %}
    return {
        "host":     os.environ.get("DB_HOST", "127.0.0.1"),
        "port":     int(os.environ.get("DB_PORT", "3306")),
        "user":     os.environ.get("DB_USER", "root"),
        "password": os.environ.get("DB_PASSWORD", ""),
        "database": os.environ.get("DB_NAME", "{{ pkg_name }}"),
        "cursorclass": pymysql.cursors.DictCursor,
    }
    {% endif %}


@contextmanager
def get_connection() -> Generator[pymysql.connections.Connection, None, None]:
    """Yield a pymysql connection and commit/rollback automatically."""
    conn = pymysql.connect(**_connection_params())
    try:
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def init_db() -> None:
    """Create the example 'users' table if it does not exist."""
    with get_connection() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                CREATE TABLE IF NOT EXISTS users (
