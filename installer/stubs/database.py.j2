from __future__ import annotations

{% if db_abstraction != "none" %}
{% if has_env_module %}
from {{ pkg_name }}.env import get_env
{% else %}
import os
{% endif %}
from contextlib import contextmanager
from typing import Generator

from sqlalchemy import Integer, String, create_engine, text
from sqlalchemy.orm import DeclarativeBase, Mapped, Session, mapped_column, sessionmaker

# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------
# DATABASE_URL examples:
{% if db_driver == "sqlite" %}
#   sqlite:///./{{ pkg_name }}.db          (relative path — dev)
#   sqlite:////absolute/path/to/db.sqlite  (absolute path)
{% elif db_driver == "mysql" or db_driver == "mariadb" %}
#   mysql+pymysql://user:password@host:3306/dbname
{% elif db_driver == "postgresql" %}
#   postgresql+psycopg2://user:password@host:5432/dbname
{% elif db_driver == "mssql" %}
#   mssql+pyodbc://user:password@host:1433/dbname?driver=ODBC+Driver+17+for+SQL+Server
{% elif db_driver == "oracle" %}
#   oracle+oracledb://user:password@host:1521/service_name
{% else %}
#   See the SQLAlchemy docs for your driver's URL format.
{% endif %}
DATABASE_URL: str = {% if has_env_module %}get_env{% else %}os.environ.get{% endif %}(
    "DATABASE_URL",
{% if db_driver == "sqlite" %}
    "sqlite:///./{{ pkg_name }}.db",
{% else %}
    "",  # Set DATABASE_URL in .env before running
{% endif %}
)

engine = create_engine(
    DATABASE_URL,
{% if db_driver == "sqlite" %}
    connect_args={"check_same_thread": False},  # required for SQLite + multi-thread
{% endif %}
    echo=False,  # Set to True to log all SQL statements
)

_SessionFactory = sessionmaker(bind=engine, autocommit=False, autoflush=False)


# ---------------------------------------------------------------------------
# Base and models
# ---------------------------------------------------------------------------

class Base(DeclarativeBase):
    pass


class User(Base):
    """Example model — replace or extend with your own."""

    __tablename__ = "users"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, index=True)
    name: Mapped[str] = mapped_column(String(255), nullable=False)
    email: Mapped[str] = mapped_column(String(255), unique=True, nullable=False)

    def __repr__(self) -> str:
        return f"User(id={self.id!r}, name={self.name!r}, email={self.email!r})"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def init_db() -> None:
    """Create all tables that do not yet exist.  Safe to call on every startup."""
    Base.metadata.create_all(bind=engine)


@contextmanager
def get_session() -> Generator[Session, None, None]:
    """Yield a database session and commit/rollback automatically."""
    session = _SessionFactory()
    try:
        yield session
        session.commit()
    except Exception:
        session.rollback()
        raise
    finally:
        session.close()


# ---------------------------------------------------------------------------
# CRUD helpers
# ---------------------------------------------------------------------------

def create_user(session: Session, *, name: str, email: str) -> User:
    """Insert a new user row and return the persisted instance."""
    user = User(name=name, email=email)
    session.add(user)
    session.flush()  # populate user.id without closing the transaction
    return user


def get_user(session: Session, user_id: int) -> User | None:
    """Return the user with the given primary key, or None if not found."""
    return session.get(User, user_id)


def list_users(session: Session) -> list[User]:
    """Return all users ordered by id."""
    return session.query(User).order_by(User.id).all()


def update_user(
    session: Session,
    user_id: int,
    *,
    name: str | None = None,
    email: str | None = None,
) -> User | None:
    """Update name/email on an existing user.  Returns None if not found."""
    user = get_user(session, user_id)
    if user is None:
        return None
    if name is not None:
        user.name = name
    if email is not None:
        user.email = email
    return user


def delete_user(session: Session, user_id: int) -> bool:
    """Delete a user by id.  Returns True if deleted, False if not found."""
    user = get_user(session, user_id)
    if user is None:
        return False
    session.delete(user)
    return True


def health_check(session: Session) -> bool:
    """Return True if the database is reachable."""
    try:
        session.execute(text("SELECT 1"))
        return True
    except Exception:
        return False

