"""
Shared environment variable reader for {{ project_name }}.

All .env reads in this package go through get_env() so that:
  - Values are loaded once and cached (avoids repeated disk reads)
  - Stale shell variables (set via `export` in a parent shell) cannot
    override .env credentials at runtime
  - A single reload_env() call refreshes everything at once

Usage:
    from {{ pkg_name }}.env import get_env, reload_env

    db_url = get_env("DATABASE_URL")
    level  = get_env("LOG_LEVEL", "INFO")
    reload_env()           # force a re-read of .env on next call
"""
from __future__ import annotations

import os
from pathlib import Path

from dotenv import dotenv_values

_cache: dict[str, str | None] | None = None


def _env_path() -> Path:
    """
    Resolve the .env file path.

    Uses {{ pkg_name | upper }}_ROOT_DIR if set (written to os.environ by __init__.py
    before any package imports occur), otherwise falls back to CWD.
    """
    root = os.environ.get("{{ pkg_name | upper }}_ROOT_DIR")
    return Path(root) / ".env" if root else Path(".env")


def get_env(key: str, default: str = "") -> str:
    """
    Read *key* from .env, returning *default* if absent.

    The parsed file is cached after the first call; use reload_env() to
    invalidate the cache (e.g. after writing new values to .env).
    """
    global _cache
    if _cache is None:
        _cache = dotenv_values(_env_path())
    return _cache.get(key) or default


def reload_env() -> None:
    """Discard the cached .env values; next get_env() call re-reads the file."""
    global _cache
    _cache = None
