class TestAdd(unittest.TestCase):
    def test_positive_numbers(self) -> None:
        self.assertEqual(add(2, 3), 5)

    def test_negative_numbers(self) -> None:
        self.assertEqual(add(-1, -2), -3)

    def test_zero_identity(self) -> None:
        self.assertEqual(add(0, 42), 42)


class TestGreet(unittest.TestCase):
    def test_returns_greeting(self) -> None:
        self.assertEqual(greet("World"), "Hello, World!")

    def test_raises_on_blank_name(self) -> None:
        with self.assertRaises(ValueError):
            greet("   ")
{% if use_mock %}


class TestFetchUser(unittest.TestCase):
    """Demonstrates unittest.mock — replace fetch_user with your real function."""

    def setUp(self) -> None:
        # MagicMock can stand in for any object (DB session, HTTP client, etc.)
        self.mock_db = MagicMock()

    @patch("tests.test_sample_unittest.fetch_user")
    def test_fetch_user_is_called_with_id(self, mock_fetch: MagicMock) -> None:
        mock_fetch.return_value = {"id": 1, "name": "Alice"}

        result = fetch_user(1)

        mock_fetch.assert_called_once_with(1)
        self.assertEqual(result["name"], "Alice")

    def test_mock_db_returns_configured_value(self) -> None:
        self.mock_db.get_user.return_value = {"id": 2, "name": "Bob"}

        result = self.mock_db.get_user(2)

        self.mock_db.get_user.assert_called_once_with(2)
        self.assertEqual(result["name"], "Bob")
