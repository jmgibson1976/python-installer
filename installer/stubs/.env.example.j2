APP_PORT=8000
APP_NAME={{ project_name }}
APP_VERSION={{ version }}
APP_DEBUG=false

# Optional: override project root for non-standard deployment layouts
# {{ pkg_name | upper }}_ROOT_DIR=/absolute/path/to/project
{% if docker == "docker" and db_driver not in ("none", "sqlite") %}
FORWARD_DB_PORT={% if db_driver == "postgresql" %}5432{% elif db_driver in ("mysql", "mariadb") %}3306{% elif db_driver == "mssql" %}1433{% elif db_driver == "oracle" %}1521{% elif db_driver == "nosql" %}27017{% endif %}

{% endif %}
{% if db_driver == "postgresql" %}
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}
DB_NAME={{ pkg_name }}
DB_USER={{ pkg_name }}
DB_PASSWORD=secret
{% elif db_driver in ("mysql", "mariadb") %}
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@localhost:3306/${DB_NAME}
DB_NAME={{ pkg_name }}
DB_USER={{ pkg_name }}
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
{% elif db_driver == "mssql" %}
DATABASE_URL=mssql+pyodbc://${DB_USER}:${DB_PASSWORD}@localhost:1433/${DB_NAME}?driver=ODBC+Driver+18+for+SQL+Server
DB_NAME={{ pkg_name }}
DB_USER=sa
DB_PASSWORD=Secret1234!
{% elif db_driver == "oracle" %}
DATABASE_URL=oracle+oracledb://${DB_USER}:${DB_PASSWORD}@localhost:1521/?service_name=${DB_NAME}
DB_NAME={{ pkg_name }}
DB_USER={{ pkg_name }}
DB_PASSWORD=secret
{% elif db_driver == "nosql" %}
MONGO_URI=mongodb://${DB_USER}:${DB_PASSWORD}@localhost:27017/${DB_NAME}
DB_NAME={{ pkg_name }}
DB_USER=
DB_PASSWORD=
{% endif %}
{% if logging_enabled %}
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_CONSOLE=true
{% endif %}
